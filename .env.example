# ─────────────────────────────────────────────────────────────────────────
# Ropofy — renderizador de propuestas · variables de entorno
# Copia este archivo a .env.local y completa lo que necesites. Todo es
# OPCIONAL: sin nada configurado, la app corre con almacenamiento en memoria
# (respaldado por ./.data en local) y sin webhook.
# ─────────────────────────────────────────────────────────────────────────

# Bus de eventos → n8n → Ropofy (GHL). UN solo endpoint recibe TODOS los
# eventos (propuesta_enviada, documento_abierto, plan_explorado,
# observacion_escrita, propuesta_aceptada, condicion_expirada).
# Si está vacío, los eventos se registran localmente y NO se envían.
# Si está definido, se hace POST con reintentos (fire-and-forget): una falla
# del endpoint nunca bloquea ni retrasa la UX.
EVENTS_WEBHOOK_URL=

# Almacenamiento compartido — Redis (Vercel KV / Upstash).
# OBLIGATORIO en producción serverless (Vercel): sin un store compartido, cada
# función tiene su propia memoria y una propuesta guardada al "Cargar" no se
# encuentra al abrir el listado o la presentación (cada request cae en otra
# instancia). Con estas variables, la app usa Redis automáticamente.
#
# Se aceptan los dos nombres: los de Vercel KV o los de Upstash. Al crear el
# store desde el Marketplace de Vercel, estas variables se inyectan solas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa (mismos valores, nombres de Upstash):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Autenticación (Auth.js) — Microsoft Entra ID / Cuenta Microsoft.
# Protege el área del CONSULTOR. El enlace del cliente (/p/[token]) y la
# telemetría que ese documento dispara quedan PÚBLICOS siempre.
#
# Sin estas variables, el login está DESACTIVADO (dev/CI/preview): la app
# corre sin registro de app en Azure. Definiéndolas en el servidor (Vercel)
# se activa el login.
# ─────────────────────────────────────────────────────────────────────────

# Del registro de app en Microsoft Entra (portal.azure.com → Entra ID →
# App registrations). Redirect URI: https://TU-DOMINIO/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Issuer/tenant. "common" permite cuentas de trabajo/escuela Y personales.
# Para restringir a tu organización, usa el issuer de tu tenant:
# https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Secreto para firmar la sesión (obligatorio en producción):
#   npx auth secret     # o: openssl rand -base64 32
AUTH_SECRET=

# Lista de acceso (OPCIONAL pero MUY recomendada en producción): sin ella,
# cualquier cuenta Microsoft autenticada entra. Restringe por correo y/o
# dominio (separados por coma).
# AUTH_ALLOWED_DOMAINS=ropofy.com
# AUTH_ALLOWED_EMAILS=jaime@ropofy.com
